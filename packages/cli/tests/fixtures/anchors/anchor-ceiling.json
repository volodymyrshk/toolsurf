    "tools": [
      {
        "name": "get_weather",
        "description": "Get the current weather forecast for a specified city. Returns temperature, humidity, and conditions. This tool only reads public weather data and performs no writes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "enum": ["New York", "London", "Tokyo", "Berlin", "Sydney", "Paris"],
              "description": "City to get weather for"
            },
            "units": {
              "type": "string",
              "enum": ["celsius", "fahrenheit"],
              "description": "Temperature units"
            }
          },
          "required": ["city"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        }
      },
      {
        "name": "calculate",
        "description": "Perform a safe mathematical calculation. Accepts arithmetic formulas only (no eval). Returns the numeric result. This is a pure computation with no side effects.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string",
              "pattern": "^[0-9+\\-*/().\\s]+$",
              "maxLength": 200,
              "description": "Mathematical formula to evaluate (arithmetic only)"
            }
          },
          "required": ["formula"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        }
      },
      {
        "name": "get_time",
        "description": "Get the current time in a specified timezone. Returns an ISO 8601 timestamp. Read-only operation with no side effects.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "timezone": {
              "type": "string",
              "enum": ["UTC", "US/Eastern", "US/Pacific", "Europe/London", "Asia/Tokyo"],
              "description": "IANA timezone identifier"
            }
          },
          "required": ["timezone"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        }
      }
    ],
