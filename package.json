{
  "name": "toolsurf-monorepo",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "ToolSurf — security audits for AI agents, MCP servers, and tool interfaces",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter toolsurf dev",
    "build": "bun run --filter toolsurf build",
    "test": "bun run --filter toolsurf test",
    "lint": "eslint packages/*/src/**/*.ts",
    "typecheck": "tsc -p packages/cli/tsconfig.json --noEmit",
    "validate:reports": "node scripts/validate-scan-reports.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "author": "Volodymyr Shkarban (https://github.com/volodymyrshk)",
  "contributors": [
    "Oleksandr Leontiev"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/volodymyrshk/toolsurf"
  },
  "homepage": "https://github.com/volodymyrshk/toolsurf#readme",
  "bugs": {
    "url": "https://github.com/volodymyrshk/toolsurf/issues"
  }
}
